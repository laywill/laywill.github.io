---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Path (under public/fonts) of the above-the-fold display font this page
   * actually renders, e.g. "raleway-700.woff2". Only pages with a hero that
   * uses --font-display need this — leave unset to skip the preload rather
   * than high-priority-fetching a face the page never uses.
   */
  preloadFont?: string;
}

const { title, description = "Personal site of William Lay.", preloadFont } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    {
      preloadFont && (
        <link
          rel="preload"
          href={`/fonts/${preloadFont}`}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-editor);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }
</style>

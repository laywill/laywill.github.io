---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal site of William Lay." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!--
      Preload the display face used above the fold (Raleway bold, used for
      the hero name treatment) so it's fetched immediately rather than being
      discovered only once tokens.css is parsed.
    -->
    <link
      rel="preload"
      href="/fonts/raleway-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-editor);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }
</style>

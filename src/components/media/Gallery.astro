---
/*
 * Gallery.astro — grid of thumbnails opening a high-resolution rendition in
 * a lightbox (docs/overhaul/component-library.md, "Media" and "Client
 * JavaScript"; the #27 issue acceptance criteria for this component).
 *
 * Two renditions, one source, one build-time cost:
 *   - A small in-grid rendition, produced via ResponsiveImage.astro (which
 *     itself wraps astro:assets' <Picture>, so it still ends up calling
 *     getImage() per format/width — reusing our own thin wrapper here
 *     rather than hand-rolling a second <picture> gets thumbnails the same
 *     AVIF/WebP + lazy-loading treatment as everywhere else on the site).
 *   - A single larger rendition, produced with one direct getImage() call
 *     per item below. Its URL is written ONLY into `data-full` (plus
 *     `href`, for the no-JS case — see below); it is never assigned to an
 *     `<img src>`, never preloaded, and there is no hidden `<img>` holding
 *     it. A browser therefore has no reason to fetch it until lightbox.ts
 *     reads the attribute and assigns it to the dialog's <img> on open.
 *     One format (WebP) and one fixed width is enough here: unlike the
 *     always-visible thumbnail, this image is loaded once, on demand, into
 *     a plain <img> rather than a <picture>, so there is no <source>
 *     negotiation to benefit from a second format.
 *
 * Progressive enhancement: every grid cell is a real <a href> pointing
 * straight at the full rendition, so a visitor with JavaScript disabled or
 * failed still reaches the full-size image — just via navigation instead of
 * a dialog. lightbox.ts upgrades the click into showModal() and cancels the
 * navigation; it is an enhancement layered on working markup, not a
 * replacement for it. (component-library.md's own "Client JavaScript"
 * section describes the trigger as a <button>; the issue brief for this
 * component is explicit that it must be a real <a href> instead, precisely
 * so the no-JS path is a normal navigation rather than a dead control. This
 * component follows the issue brief — see the closing report for the full
 * note on that discrepancy.)
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import ResponsiveImage from "./ResponsiveImage.astro";

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: readonly GalleryItem[];
  /** Unique id — a page may hold more than one gallery. */
  id: string;
  class?: string;
}

const { items, id, class: className } = Astro.props;

/*
 * Thumbnail widths/sizes. Chosen against --content-max (72rem = 1152px):
 * at the lg (1200px) 3-up grid a cell is roughly a third of that, so 640px
 * covers a ~2x-density thumbnail without generating a rendition no layout
 * on this site will ever request; 320/480 cover the 1-up and 2-up cases at
 * common device-pixel ratios. These are passed straight through to
 * ResponsiveImage, which does not invent its own defaults (see that file) —
 * they live here because the grid's own column math is what determines
 * them.
 */
const THUMB_WIDTHS = [320, 480, 640];
const THUMB_SIZES = "(min-width: 1200px) 33vw, (min-width: 640px) 50vw, 100vw";

/*
 * Lightbox rendition width. 1600px comfortably fills a desktop viewport at
 * the dialog's own `min(90vw, var(--content-max))` cap (see the <style>
 * block) while staying under the 2000px source width the demo images and
 * the image-pipeline docs (#31) both cap committed originals at, so this
 * never asks the image service to upscale.
 */
const LIGHTBOX_WIDTH = 1600;
const LIGHTBOX_FORMAT = "webp";

// Build-time only: astro:assets' getImage() does the actual resizing/
// re-encoding here, once per item, at build. Nothing in this loop runs in
// the browser.
const resolved = await Promise.all(
  items.map(async (item) => {
    const full = await getImage({
      src: item.src,
      width: LIGHTBOX_WIDTH,
      format: LIGHTBOX_FORMAT,
    });
    return { item, full };
  }),
);
---

<div class:list={["gallery", className]} data-lightbox-gallery>
  {/* House rule, applied to every unstyled list in this library, not just
  this one: role="list" defends against Safari/VoiceOver dropping list
  semantics from a <ul>/<ol> the moment `list-style: none` is applied — a
  known engine quirk, not a WAI-ARIA requirement on unstyled lists in
  general. Restoring the role costs one attribute and keeps the semantics
  regardless of engine. */}
  <ul class="grid" role="list">
    {
      resolved.map(({ item, full }) => (
        <li class="cell">
          <a
            href={full.src}
            class="thumb-link"
            data-lightbox-trigger
            data-full={full.src}
            data-full-width={String(full.attributes.width ?? "")}
            data-full-height={String(full.attributes.height ?? "")}
            data-alt={item.alt}
            data-caption={item.caption ?? ""}
          >
            <ResponsiveImage
              src={item.src}
              alt={item.alt}
              widths={THUMB_WIDTHS}
              sizes={THUMB_SIZES}
              loading="lazy"
              class="thumb"
            />
          </a>
          {item.caption && <p class="cell-caption">{item.caption}</p>}
        </li>
      ))
    }
  </ul>

  {/*
    One dialog per gallery, keyed off `id` as the props contract requires.
    It starts with no image `src` at all (not even `src=""`, which some
    browsers resolve against the current document) and no accessible name —
    both are only meaningful once something is actually open, and a closed
    <dialog> (no `open` attribute) is `display: none` by the UA stylesheet
    and outside the accessibility tree regardless.
  */}
  <dialog id={`${id}-dialog`} class="lightbox" data-lightbox-dialog>
    <button
      type="button"
      class="lightbox-close"
      data-lightbox-close
      aria-label="Close image preview"
    >
      {/* The glyph alone is not an accessible name — aria-label above
      carries it; the icon is decorative alongside that name. */}
      <Icon name="lucide:x" aria-hidden="true" class="glyph" />
    </button>
    <img class="lightbox-image" data-lightbox-image alt="" />
    <p class="lightbox-caption" data-lightbox-caption hidden></p>
  </dialog>
</div>

<script>
  // Hoisted module import. Astro dedupes identical inline/hoisted scripts
  // by content across every instance of this component on a page, so with
  // N galleries on one page this module is still emitted and executed
  // exactly once — see lightbox.ts's own header comment for why that means
  // it must not assume a single gallery exists.
  import "../../scripts/lightbox.ts";
</script>

<style>
  .gallery {
    /* No layout of its own beyond the grid below — the caller positions
    the gallery within a Section/Pane. */
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* sm (640px): 2-up. Below this, a single column is what keeps the
  360px floor free of horizontal scroll — a thumbnail narrow enough to fit
  two per row at 360px is too small to read, so single-column is the
  correct floor behaviour, not just the safe one. */
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* lg (1200px): 3-up, per component-library.md's breakpoint table. */
  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .thumb-link {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    line-height: 0; /* Collapses the inline-image gap under the anchor. */
    box-shadow: var(--elevation-1);

    /* Depth is the gloss lever spent here (component-library.md's gloss
    table): elevation rises on hover AND focus, not just hover, so a
    keyboard user gets the same "lifted" affordance a mouse user gets. */
    transition: box-shadow var(--duration-base) var(--ease-standard);
  }

  .thumb-link:hover,
  .thumb-link:focus-visible {
    box-shadow: var(--elevation-2);
  }

  .thumb-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  /* ResponsiveImage renders a <picture> wrapping an <img class="thumb">
  (Picture.astro applies a caller's `class` to the inner <img>, not the
  <picture> itself) — both need `display: block` since <picture> is inline
  by default and would otherwise leave a baseline gap under the image, and
  the <img> needs to fill the cell so the border/radius above reads as the
  image's own frame rather than a frame around whitespace. */
  .thumb-link :global(picture) {
    display: block;
  }

  .thumb-link :global(img.thumb) {
    display: block;
    width: 100%;
    height: auto;
  }

  .cell-caption {
    margin: 0;
    color: var(--fg-secondary);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  /*
   * The lightbox dialog. Sized against --content-max rather than a new
   * literal: it is a large image viewer, not a fixed-width panel, so it
   * should track the same content ceiling as the rest of the page while
   * still respecting the viewport at the 360px floor via the `min()`.
   */
  .lightbox {
    box-sizing: border-box;
    width: min(90vw, var(--content-max));
    max-height: 85vh;
    margin: auto; /* Centres a non-fullscreen <dialog> in both axes. */
    padding: var(--space-md);
    background-color: var(--bg-editor);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-3);
    color: var(--fg);
    z-index: var(--z-lightbox);

    /*
     * Column flex, rather than the image being sized against a hand-tuned
     * `calc(85vh - 2 * var(--space-md))`: that subtraction only ever
     * accounted for the dialog's own padding, not the caption that roughly
     * half the demo gallery items render below the image. The caption's
     * margin-top plus its own line box pushed straight through the fixed
     * cap on every item with a caption, and `max-height` on `.lightbox`
     * combined with no `overflow` set meant that overflow was simply
     * invisible rather than scrollable. Flex-column instead lets the
     * caption claim whatever space its content needs first, so the image
     * (below, `flex: 0 1 auto` with `min-height: 0`) only ever gets what's
     * left inside the 85vh cap — correct with a caption, without a caption,
     * and at any caption length, with no subtraction to keep in sync by
     * hand.
     */
    display: flex;
    flex-direction: column;

    /*
     * Entry/exit transition is CSS-only via @starting-style + allow-discrete
     * — no script drives this animation (lightbox.ts only ever calls
     * showModal()/close()), so the central prefers-reduced-motion override
     * in tokens.css (which collapses --duration-base to 1ms) is sufficient
     * on its own; there is nothing here for the script to separately guard.
     * Unsupported browsers (no @starting-style) simply skip the transition
     * and show/hide the dialog instantly — a functional no-op, not a
     * broken state.
     */
    opacity: 0;
    transform: translateY(var(--space-2xs)) scale(0.98);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard),
      overlay var(--duration-base) var(--ease-standard) allow-discrete,
      display var(--duration-base) var(--ease-standard) allow-discrete;
  }

  .lightbox[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
      transform: translateY(var(--space-2xs)) scale(0.98);
    }
  }

  /*
   * The scrim is its own token rather than another elevation step: elevation
   * describes how far a surface sits above the page, whereas this dims
   * everything behind a surface that has taken over the viewport.
   */
  .lightbox::backdrop {
    background: var(--scrim);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      overlay var(--duration-base) var(--ease-standard) allow-discrete,
      display var(--duration-base) var(--ease-standard) allow-discrete;
  }

  .lightbox[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .lightbox[open]::backdrop {
      opacity: 0;
    }
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    /* No max-height here — the flex-column parent above is what constrains
    this now. `flex: 0 1 auto` lets the image take its natural size up to
    whatever height the column has left after the caption (min-height: 0
    overrides the flex default of `min-height: auto`, which would otherwise
    refuse to shrink the image below its intrinsic size and defeat the
    whole arrangement). */
    flex: 0 1 auto;
    min-height: 0;
    margin: 0 auto;
    border-radius: var(--radius-md);
  }

  .lightbox-caption {
    /* flex: none — the caption always renders at its natural height; it is
    the image that yields space to it, never the other way round. */
    flex: none;
    margin: var(--space-sm) 0 0;
    color: var(--fg-secondary);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background-color: var(--bg-sidebar);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .lightbox-close:hover {
    background-color: var(--bg-highlight);
  }

  .lightbox-close:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .glyph {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>

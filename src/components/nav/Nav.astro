---
/*
 * Nav.astro — the single site navigation (docs/overhaul/component-library.md,
 * "Navigation — nav/"; docs/overhaul/design-direction.md, "1. Explorer
 * sidebar"; the "narrow viewports" decision for the tab-bar form).
 *
 * ONE <nav> containing ONE <ul>, rendered as an explorer sidebar at >=900px
 * and as a horizontally scrolling editor-tab bar below it, by CSS alone.
 * There is no duplicate DOM: a screen reader meets this navigation once
 * regardless of viewport, and no JavaScript is involved in the switch.
 *
 * Mobile-first: the base (unqualified) rules below are the tab-bar form;
 * the single `min-width: 900px` query layers the sidebar form on top,
 * matching the `md` breakpoint documented once in component-library.md.
 */
import type { NavEntry } from "../../data/nav";
import { NAV, ROOT_LABEL, SITE_LABEL } from "../../data/nav";
import { accentVar } from "../../lib/accents";

interface Props {
  entries?: readonly NavEntry[];
  activeId?: string;
  class?: string;
}

const { entries = NAV, activeId, class: className } = Astro.props;
---

<nav aria-label="Site" class:list={["nav", className]}>
  {/*
    The site label and root row exist to sell the file-explorer motif, not
    to navigate anywhere — neither is a link or a heading for the list that
    follows (the <nav>'s own aria-label already names it "Site"). That
    makes them set dressing under component-library.md rule 5, so they are
    pulled out of the accessibility tree rather than read as two more
    (inert) rows ahead of the real navigation.
  */}
  <p class="site-label" aria-hidden="true">{SITE_LABEL}</p>
  <p class="root-row" aria-hidden="true">
    <span class="root-glyph">▸</span>{ROOT_LABEL}
  </p>
  <ul class="rows">
    {
      entries.map((entry) => {
        const isActive = entry.id === activeId;
        return (
          <li>
            {entry.pending ? (
              /* design-direction.md is explicit that a route which does not
              exist yet must never ship as a dead link, so this is a <span>,
              not an <a> — inert, not focusable, and understood by the "no
              client JS unless earned" rule to need no click-blocking
              handler because there is nothing to click. The visually-hidden
              suffix carries the "not yet available" fact to a screen
              reader; `title` gives sighted mouse users the same on hover. */
              <span class="row row--pending" title="Coming soon">
                <span
                  class="glyph"
                  aria-hidden="true"
                  style={`color: ${accentVar(entry.accent)}`}
                >
                  {entry.glyph}
                </span>
                <span class="file">{entry.file}</span>
                <span class="visually-hidden"> (coming soon)</span>
              </span>
            ) : (
              /* The glyph is decorative (aria-hidden); the visible text is
              the bare filename, e.g. "about.md". NavEntry.label supplies the
              plain-English destination, appended visually-hidden rather than
              set as an aria-label that would replace the filename outright.

              That distinction is WCAG 2.5.3 (Label in Name): an aria-label of
              "About" on a control whose visible label reads "about.md" leaves
              the accessible name with no substring in common with what a
              speech-input user can see and say, so "click about dot em dee"
              would not activate it. Appending instead keeps the visible text
              at the start of the accessible name — "about.md, About" — which
              satisfies 2.5.3 and still spares a screen-reader user having to
              decode a filename on its own. */
              <a
                class:list={["row", { "row--active": isActive }]}
                href={entry.href}
                aria-current={isActive ? "page" : undefined}
              >
                <span
                  class="glyph"
                  aria-hidden="true"
                  style={`color: ${accentVar(entry.accent)}`}
                >
                  {entry.glyph}
                </span>
                <span class="file">{entry.file}</span>
                <span class="visually-hidden">, {entry.label}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    background-color: var(--bg-sidebar);

    /* Tab-bar form: a bottom hairline stands in for the sidebar's right
    one, and the strip scrolls internally so the PAGE never gains
    horizontal scroll at the 360px floor. */
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .site-label,
  .root-row {
    /* Sidebar chrome only — see component-library.md's narrow-viewport
    decision. Hidden (not just visually collapsed) below 900px because an
    element this small has no useful role in the scrolling tab strip. */
    display: none;
  }

  .rows {
    display: flex;
    flex-direction: row;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li {
    flex: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--fg-secondary);
    text-decoration: none;
    white-space: nowrap;

    /* A transparent marker at rest, coloured only when active — sizing the
    marker once here means the active state never shifts the row's box. */
    border-bottom: var(--focus-ring-width) solid transparent;

    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  a.row:hover {
    background-color: var(--bg-highlight);
  }

  a.row:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  /* Two cues, never one (component-library.md rule 4): the fill AND the
  marker both carry "active", so the state never depends on the marker's
  1.51:1 border colour alone. */
  .row--active {
    background-color: var(--bg-active);
    border-bottom-color: var(--statusbar-blue);
    color: var(--fg);
  }

  .glyph {
    /* Decorative and aria-hidden — small text is only permitted here under
    the design doc's 14px-floor correction because it never reaches
    assistive tech. */
    font-size: var(--font-size-sm);
    flex: none;
  }

  .row--pending {
    cursor: default;
  }

  /* Standard clip-based visually-hidden pattern (matches ui/Button.astro).
  The four 1px-scale values are the technique itself, not a design/spacing
  value, so they are not drawn from the space scale. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .nav {
      flex-direction: column;
      width: var(--sidebar-width);
      height: 100%;
      border-bottom: none;
      border-right: 1px solid var(--border);
      overflow-x: visible;
      overflow-y: auto;
    }

    .site-label {
      display: block;
      margin: 0;
      padding: var(--space-sm) var(--space-sm) var(--space-2xs);
      font-size: var(--font-size-base);
      color: var(--fg-secondary);
    }

    .root-row {
      display: flex;
      align-items: center;
      gap: var(--space-3xs);
      margin: 0;
      padding: var(--space-2xs) var(--space-sm);
      font-size: var(--font-size-base);
      color: var(--fg-secondary);
    }

    .root-glyph {
      flex: none;
    }

    .rows {
      flex-direction: column;
    }

    .rows li {
      flex: none;
    }

    .row {
      /* The marker moves from the bottom edge (tab-bar form) to a 2px left
      edge (sidebar form) — same transparent-until-active technique. */
      border-bottom: none;
      border-left: var(--focus-ring-width) solid transparent;
    }

    .row--active {
      border-left-color: var(--statusbar-blue);
    }
  }
</style>

---
/*
 * Button.astro — the hero's CTA pair (docs/overhaul/component-library.md,
 * "UI primitives"; docs/overhaul/design-direction.md, "3. Hero").
 *
 * Always an <a>, never a <button>: every use in the design is a navigation
 * (LinkedIn, a CV download) rather than an in-page action with no href of
 * its own, so there is no button-element variant to maintain. If a future
 * caller needs a real form-submit or JS-triggered action, that is a
 * different component, not a mode of this one.
 *
 * Primary vs secondary is carried by FILL vs OUTLINE (component-library.md
 * rule 4, "colour is never the only cue") — variant must never be
 * distinguished by colour alone, so the CSS below changes background/border
 * structure, not just which accent is used.
 */
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  /** "primary" is a --statusbar-blue fill; "secondary" an --accent-blue outline. Default "primary". */
  variant?: "primary" | "secondary";
  /** Iconify name for a leading glyph, e.g. "simple-icons:linkedin". */
  icon?: string;
  /** Opens in a new tab: sets target/rel and appends a visually-hidden warning to the accessible name. */
  external?: boolean;
  /** Marks the link as a download. */
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  icon,
  external = false,
  download = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={["button", variant, className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download ? true : undefined}
>
  {
    icon && (
      /* The glyph is decoration alongside a text label, not a substitute
      for one — every use in the design pairs it with a slotted word — so
      it is pulled out of the accessible name rather than describing
      itself twice. */
      <Icon name={icon} aria-hidden="true" class="glyph" />
    )
  }
  <slot />
  {
    external && (
      /* The label alone ("Connect on LinkedIn") does not tell an
      assistive-technology user the link leaves the site; sighted users
      get that from context/convention instead, so this text is visually
      hidden but stays in the accessible name. */
      <span class="visually-hidden"> (opens in a new tab)</span>
    )
  }
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--elevation-1);

    /* Background, border-colour and elevation all move on hover, per the
    "gloss" vocabulary in component-library.md: state is a background
    change (--duration-fast) and depth is a transform/elevation change
    (--duration-base), each on its own token so a reduced-motion visitor
    still gets an instant, correct end state. */
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .button:hover {
    box-shadow: var(--elevation-2);
  }

  .button:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .glyph {
    width: 1em;
    height: 1em;
    flex: none;
  }

  /* Primary: solid fill, per the design doc "--statusbar-blue fill with
  --fg-on-accent text". Hover darkens toward the fill itself is not
  available as a token, so hover is carried by the elevation raise above
  plus a highlight background swap, matching the "State" row of the gloss
  table (--bg-highlight / --bg-active are background changes, not glows). */
  .button.primary {
    background-color: var(--statusbar-blue);
    color: var(--fg-on-accent);
    border: 1px solid var(--statusbar-blue);
  }

  .button.primary:hover {
    background-color: var(--bg-active);
    border-color: var(--bg-active);
  }

  /* Secondary: outline only, no fill — the OUTLINE half of the fill/outline
  distinction the design doc requires. */
  .button.secondary {
    background-color: transparent;
    color: var(--accent-blue);
    border: 1px solid var(--accent-blue);
  }

  .button.secondary:hover {
    background-color: var(--bg-highlight);
  }

  /* Visually hidden but still reachable by assistive tech — the standard
  clip-based pattern, not display:none (which would remove it from the
  accessible name too). */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Windows-oriented scripts — always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common text/config/source formats used by this site — normalize to LF
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.astro text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.svg text eol=lf

# Git-specific
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files — never diff or convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# GitHub Linguist — the compiled build output shouldn't count toward
# language stats or show up in diffs once Astro scaffolding lands.
dist/* linguist-generated
.astro/* linguist-generated
